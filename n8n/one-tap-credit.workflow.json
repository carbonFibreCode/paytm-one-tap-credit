{
  "name": "One-Tap Credit — detection to nudge",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "one-tap-credit",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Transaction event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-200, 300],
      "webhookId": "a1000000-0000-4000-8000-000000000001"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://REPLACE-ME.vercel.app/api/decide",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": { "timeout": 8000 }
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Decision engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [20, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-show-nudge",
              "leftValue": "={{ $json.showNudge }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Eligible for a nudge?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Choose the plan the copy should lead with: a no-cost option if one\n// exists, otherwise the smallest instalment. Then build the nudge-text call.\nconst decision = $input.first().json;\nconst offer = decision.offer;\n\nconst headline =\n  offer.tenures.find((t) => t.noCost) ??\n  offer.tenures.reduce((low, t) => (t.emi < low.emi ? t : low));\n\nreturn [\n  {\n    json: {\n      decision,\n      nudgeRequest: {\n        product: decision.product,\n        partner: offer.partner,\n        amount: decision.amount,\n        merchantName: decision.merchant.name,\n        merchantCategory: decision.merchant.category,\n        months: headline.months,\n        emi: headline.emi,\n        noCost: headline.noCost,\n        language: decision.user.preferredLanguage,\n      },\n    },\n  },\n];"
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Pick headline plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://REPLACE-ME.vercel.app/api/nudge-text",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.nudgeRequest) }}",
        "options": { "timeout": 8000 }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Sarvam nudge copy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 200]
    },
    {
      "parameters": {
        "jsCode": "// Attach the generated copy to the decision and return one payload.\nconst decision = $('Pick headline plan').first().json.decision;\nconst copy = $input.first().json;\n\nreturn [\n  {\n    json: {\n      ...decision,\n      nudgeText: {\n        text: copy.nudgeText,\n        source: copy.source,\n        reason: copy.reason ?? null,\n        latencyMs: copy.latencyMs ?? null,\n      },\n    },\n  },\n];"
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Attach copy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Respond with nudge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1140, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Respond, no nudge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [480, 420]
    }
  ],
  "connections": {
    "Transaction event": {
      "main": [[{ "node": "Decision engine", "type": "main", "index": 0 }]]
    },
    "Decision engine": {
      "main": [[{ "node": "Eligible for a nudge?", "type": "main", "index": 0 }]]
    },
    "Eligible for a nudge?": {
      "main": [
        [{ "node": "Pick headline plan", "type": "main", "index": 0 }],
        [{ "node": "Respond, no nudge", "type": "main", "index": 0 }]
      ]
    },
    "Pick headline plan": {
      "main": [[{ "node": "Sarvam nudge copy", "type": "main", "index": 0 }]]
    },
    "Sarvam nudge copy": {
      "main": [[{ "node": "Attach copy", "type": "main", "index": 0 }]]
    },
    "Attach copy": {
      "main": [[{ "node": "Respond with nudge", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
