# Cognee sidecar credentials. Copy to `cognee-service/.env` and fill in.
# This file is gitignored — nothing here is committed.

# Cognee needs an LLM to extract entities into the graph.
# Either an OpenAI key, or point it at Sarvam (OpenAI-compatible).
OPENAI_TOKEN= 
# OPENAI_URL=https://api.sarvam.ai/v1
# OPENAI_MODEL=sarvam-m

# Skips downloading an embedding model. Fine for the demo, much faster to start.
MOCK_EMBEDDING=true

# Only if you are using Cognee Cloud rather than local graph storage.
COGNEE_BASE_URL=https://tenant-d027ab31-302a-4914-9bce-54c4501d41f6.aws.cognee.ai
COGNEE_API_KEY= 7a843915cafecbe3645f589cdcbac3232106551e336b6a6ff7b16b092a6eca16
COGNEE_TENANT_ID=d027ab31-302a-4914-9bce-54c4501d41f6