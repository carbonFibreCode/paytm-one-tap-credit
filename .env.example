# Copy to `.env.local` and fill in. Every value is optional — the app runs fully
# without any of them, on template copy and the direct API path.

# --- Sarvam (nudge copy generation) ---------------------------------------
# Without this, /api/nudge-text returns template copy and says so in `source`.
SARVAM_API_KEY=
# Override only if Sarvam's endpoint or model name differs from the defaults.
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_MODEL=sarvam-m

# --- n8n (orchestration) ---------------------------------------------------
# The production webhook URL of the imported workflow. When set, the checkout
# screen calls n8n first and falls back to /api/decide if it does not answer
# within 3 seconds.
# Must be reachable from the browser, so n8n Cloud needs a deployed app URL to
# call back into — localhost will not work from n8n Cloud.
NEXT_PUBLIC_N8N_WEBHOOK_URL=
