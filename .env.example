# Copy to `.env.local` (or paste into Vercel's environment variables).
# Every value is optional — the app runs fully without any of them, on template
# copy, the local audit trail and the direct decision path.

# --- Sarvam · nudge copy generation ---------------------------------------
# Without this, /api/nudge-text returns template copy and says so in `source`.
SARVAM_API_KEY=
# Override only if the endpoint or model name differs from the defaults.
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_MODEL=sarvam-m

# --- Cognee · persistent memory of offer outcomes --------------------------
# Without this, memory falls back to the local audit trail. That works offline
# but does not survive a serverless cold start, so on Vercel this is what makes
# memory durable.
COGNEE_API_KEY=
# COGNEE_API_URL=https://api.cognee.ai
# COGNEE_DATASET=one-tap-credit

# --- n8n · orchestration ---------------------------------------------------
# Production webhook URLs of the imported workflows. When set, the checkout
# calls n8n first and falls back to /api/decide after 3 seconds.
#
# Local:  http://localhost:5678/webhook/one-tap-credit
# Cloud:  https://<your-instance>.app.n8n.cloud/webhook/one-tap-credit
NEXT_PUBLIC_N8N_WEBHOOK_URL=
NEXT_PUBLIC_N8N_OUTCOME_WEBHOOK_URL=
NEXT_PUBLIC_N8N_EDITOR_URL=
