# Copy to `.env.local` (or paste into Vercel's environment variables).
# Every value is optional — the app runs fully without any of them, on template
# copy, the local audit trail and the direct decision path.

# --- Sarvam · nudge copy generation ---------------------------------------
# Without this, /api/nudge-text returns template copy and says so in `source`.
SARVAM_API_KEY=
# Override only if the endpoint or model name differs from the defaults.
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_MODEL=sarvam-m

# --- Cognee · persistent memory of offer outcomes --------------------------
# Both values come from the API Keys page at platform.cognee.ai.
# The base URL is PER-TENANT — it is not api.cognee.ai.
# Without these, memory falls back to the local audit trail.
COGNEE_API_URL=https://your-tenant.aws.cognee.ai
COGNEE_API_KEY=7a843915cafecbe3645f589cdcbac3232106551e336b6a6ff7b16b092a6eca16
COGNEE_DATASET=one-tap-credit

# --- n8n · orchestration ---------------------------------------------------
# Production webhook URLs of the imported workflows. When set, the checkout
# calls n8n first and falls back to /api/decide after 3 seconds.
#
# Local:  http://localhost:5678/webhook/one-tap-credit
# Cloud:  https://<your-instance>.app.n8n.cloud/webhook/one-tap-credit
NEXT_PUBLIC_N8N_WEBHOOK_URL=
NEXT_PUBLIC_N8N_OUTCOME_WEBHOOK_URL=
NEXT_PUBLIC_N8N_EDITOR_URL=

# --- Neon Postgres · durable audit trail ------------------------------------
# Pooled connection string from console.neon.tech. Create the project in
# ap-southeast-1 (Singapore) and pin the Vercel function region to sin1 —
# cross-region, every query costs a ~250ms round trip.
# Without this, the trail lives in `.data/decisions.jsonl` and an in-memory
# buffer, exactly as before. Apply the schema once with `npm run db:migrate`.
DATABASE_URL=

# --- QR signing -------------------------------------------------------------
# Every merchant QR is a signed payment intent (UPI 2.0 `sign`). The scanner
# rejects a payload whose signature does not verify — a sticker with a swapped
# VPA never reaches the pay screen. Any long random string; keep it the same
# across environments, or printed codes stop verifying. Without it a
# development key is used and a warning is logged once.
QR_SIGNING_SECRET=
